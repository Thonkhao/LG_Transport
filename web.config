<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security><requestFiltering><hiddenSegments>
      <add segment="config" /><add segment="dbconnect" /><add segment="Models" />
      <add segment="controller" /><add segment="tools" /><add segment="helpers" />
      <add segment="modules" /><add segment="sql" /><add segment="_backups" /><add segment=".git" />
    </hiddenSegments></requestFiltering></security>
    <defaultDocument><files><clear /><add value="index.php" /></files></defaultDocument>
  </system.webServer>
</configuration>